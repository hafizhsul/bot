# Dapat dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Whitelist chat_id yang boleh pakai bot ini (pisahkan koma).
# WAJIB diisi -- tanpa ini siapapun yang tahu username bot bisa
# menjalankan perintah shell di mesin kamu lewat OpenCode.
ALLOWED_CHAT_IDS=123456789

# Direktori project default kalau chat belum set direktori sendiri
DEFAULT_PROJECT_DIR=/home/hafizh/projects/default

# Path ke binary opencode (biarkan "opencode" kalau sudah ada di PATH)
OPENCODE_BIN=opencode

# Model yang mau dipakai, format provider/model. Kosongkan untuk pakai default opencode.
OPENCODE_MODEL=

# WAJIB true supaya opencode run non-interaktif nggak hang nunggu approval izin
# (misal izin jalanin shell command / edit file). Opencode sendiri labelin flag
# ini "dangerous" karena semua permission yang nggak ditolak eksplisit langsung
# di-approve otomatis. Kalau kamu sudah setting whitelist permission sendiri di
# opencode.json / config agent, boleh set ke false.
OPENCODE_AUTO_APPROVE=true
